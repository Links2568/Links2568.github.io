---
import { SITE } from "../consts";

interface Props {
  path: string; // "" | "/projects" | "/blog" | "/gallery"
}

const { path } = Astro.props;
const items = [
  { href: "/projects/", label: "Projects", match: "/projects" },
  { href: "/blog/", label: "Blog", match: "/blog" },
  { href: "/gallery/", label: "Photos", match: "/gallery" },
];
---

<header class="topnav">
  <a class="brand" href="/" aria-current={path === "" ? "page" : undefined}>{SITE.title}</a>
  <nav aria-label="Site">
    {
      items.map((it) => (
        <a href={it.href} aria-current={path === it.match ? "page" : undefined}>
          {it.label}
        </a>
      ))
    }
    <a href={SITE.links.cv} rel="noopener">CV</a>
    <button class="theme-toggle" type="button" aria-label="Toggle color theme">Dark</button>
  </nav>
</header>
