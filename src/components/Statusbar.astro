---
import { SITE } from "../consts";

interface Props {
  path: string; // "" | "/projects" | "/blog" | "/gallery"
}

const { path } = Astro.props;
---

<header class="topnav">
  <a class="brand" href="/">{SITE.title}</a>
  <nav aria-label="Site">
    <a href="/" aria-current={path === "" ? "page" : undefined}>home</a>
    <a href="/projects/" aria-current={path === "/projects" ? "page" : undefined}>projects</a>
    <a href="/blog/" aria-current={path === "/blog" ? "page" : undefined}>blog</a>
    <a href="/gallery/" aria-current={path === "/gallery" ? "page" : undefined}>gallery</a>
    <button class="theme-toggle" type="button" aria-label="Toggle color theme">dark</button>
  </nav>
</header>
