---
import { SITE } from "../consts";
import { asset } from "../lib/asset";
import Statusbar from "../components/Statusbar.astro";
import "../styles/cyber.css";

interface Props {
  title: string;
  description: string;
  path: string; // "" | "/projects" | "/gallery" | "/projects/slug"
  navPath?: string; // which nav item to highlight; defaults to path
  wrap?: boolean; // wrap <slot/> in the narrow .wrap column
  noindex?: boolean; // keep out of search engines / AI indexes
}

const { title, description, path, navPath = path, wrap = true, noindex = false } = Astro.props;
const canonical = new URL(path === "" ? "/" : `${path}/`, Astro.site);
const ogImage = new URL(SITE.avatar, Astro.site);
const isHome = path === "";
const email = SITE.email.replace(" (at) ", "@");
---

<!doctype html>
<html lang="en-US" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {isHome && <meta name="keywords" content={SITE.keywords} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href={SITE.favicon} type="image/png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImage} />

    {
      isHome && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            name: SITE.title,
            alternateName: SITE.zhName,
            url: `${Astro.site}`,
            image: `${ogImage}`,
            email: `mailto:${email}`,
            jobTitle: SITE.position,
            affiliation: {
              "@type": "CollegeOrUniversity",
              name: SITE.affiliation,
              sameAs: SITE.affiliationUrl,
            },
            alumniOf: {
              "@type": "CollegeOrUniversity",
              name: "University of Illinois Urbana-Champaign",
              sameAs: "https://illinois.edu",
            },
            knowsAbout: [
              "Human-AI Interaction",
              "Context-Aware Intelligent Systems",
              "Ubiquitous Sensing",
              "AI4Science",
              "Generative AI",
              "Statistical Machine Learning",
              "Climate Science",
              "Photography",
            ],
            sameAs: [SITE.links.github, SITE.links.instagram, SITE.links.linkedin],
          })}
        />
      )
    }

    <script is:inline>
      /* set theme before first paint to avoid flash */
      (function () {
        var t;
        try {
          t = localStorage.getItem("theme");
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;600&display=swap"
    />
    {
      /* calligraphy face for the Chinese name — subset to its three glyphs */
      isHome && (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&text=%E6%9D%8E%E7%A5%96%E8%87%A3&display=swap"
        />
      )
    }
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — blog`} href="/rss.xml" />
  </head>
  <body>
    <Statusbar path={navPath} />

    {
      wrap ? (
        <main class="wrap">
          <slot />
          <footer class="site-footer">
            <span>© {new Date().getFullYear()} {SITE.title} · updated {new Date().toISOString().slice(0, 10).replaceAll("-", ".")}</span>
            <span>built with <a href="https://astro.build" rel="noopener">astro</a></span>
          </footer>
        </main>
      ) : (
        <>
          <slot />
        </>
      )
    }

    <!-- stable path (not content-hashed): stale cached HTML during the
         10-minute GitHub Pages cache window must still resolve this -->
    <script is:inline src={asset("/scripts/cyber.js")} defer></script>

    <!-- GoatCounter analytics — cookieless, skips localhost by default -->
    <script
      is:inline
      data-goatcounter="https://lzclink.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </body>
</html>
