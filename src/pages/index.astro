---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE } from "../consts";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title={`${SITE.title} | ${SITE.affiliation}`}
  description={SITE.description}
  path=""
  boot={true}
  field={true}
>
  <section class="hero">
    <p class="prompt-line">whoami</p>
    <div class="hero-top">
      <div>
        <h1>{SITE.title}<span class="cursor" aria-hidden="true"></span></h1>
        <p class="role">
          {SITE.position} · <a href={SITE.affiliationUrl} rel="noopener">{SITE.affiliation}</a>
        </p>
        <p class="status"><span class="dot" aria-hidden="true"></span>{SITE.statusLine}</p>
      </div>
      <img class="avatar" src={SITE.avatar} alt={`Portrait of ${SITE.title}`} />
    </div>

    <nav class="tag-links" aria-label="Profiles">
      <a href={SITE.links.scholar} rel="noopener">scholar</a>
      <a href={SITE.links.cv} rel="noopener">cv</a>
      <a href={SITE.links.github} rel="noopener">github</a>
      <a href={SITE.links.linkedin} rel="noopener">linkedin</a>
      <a href={SITE.links.instagram} rel="noopener">instagram</a>
    </nav>

    <button class="copy-email" type="button" data-email={SITE.email} title="Copy email address">
      copy email — {SITE.email}
    </button>
  </section>

  <div class="content">
    <h2>about</h2>
    <p>
      I am an undergraduate student at the <strong>University of Michigan, Ann Arbor</strong>,
      majoring in <strong>Honors Data Science &amp; Statistics</strong> with a minor in
      <strong>History</strong>. Previously, I studied Statistics &amp; Computer Science at the
      University of Illinois Urbana-Champaign. My research interests span generative AI,
      privacy-aware machine learning, and human-computer interaction.
    </p>

    <h2>research</h2>
    <ul>
      <li><strong>Generative AI:</strong> music and audio generation, human-GenAI interaction</li>
      <li>
        <strong>Privacy &amp; Security:</strong> geolocation attack/defense with diffusion models
        and VLMs
      </li>
      <li>
        <strong>Statistical Machine Learning:</strong> dimension reduction, Bayesian methods,
        wearable data analysis
      </li>
      <li><strong>Climate Science:</strong> aerosol-cloud interactions, statistical modeling</li>
    </ul>

    <h2>projects</h2>
    <ul class="project-list">
      {
        projects.map((p) => (
          <li>
            <a class="project-link" href={`/projects/${p.id}/`}>
              <strong>{p.data.title}</strong>
            </a>{" "}
            <code>{p.data.period}</code>
            <br />
            {p.data.tagline}
          </li>
        ))
      }
    </ul>

    <h2>experience</h2>
    <ul>
      <li>
        <strong>Generative AI for Music and Audio</strong>, UMich — Research Assistant
        <code>2025.10 → now</code>
        <br />Building a universal optical music recognition framework for visually complex
        notations; exploring real-time human–GenAI interaction for controllable music generation.
      </li>
      <li>
        <strong>Ambient Intelligence Lab</strong>, UMich — Research Assistant
        <code>2025.10 → now</code>
        <br />Developing privacy-driven geolocation attack and defense frameworks using diffusion
        models and VLMs; designing intelligent IoT sensing systems with Moiré-pattern optical
        sensors.
      </li>
      <li>
        <strong>Energy Distance Dimension Reduction</strong>, UMich — URPS
        <code>2025.01 → now</code>
        <br />Applying sufficient dimension reduction to multilevel wearable data from bone marrow
        transplant patients; re-implementing SDR algorithms in JAX with 7,000× speedup.
      </li>
      <li>
        <strong>Lab of Atmospheric and Earth System Sciences</strong>, Nanjing University — Summer
        Research Intern <code>2024.05 → 2024.08</code>
        <br />Applied statistical machine learning to study aerosol-cloud interactions and improved
        simulations of aerosol optical properties and climate effects.
      </li>
      <li>
        <strong>E2-E Lab</strong>, UIUC — Undergraduate Research Assistant
        <code>2023.08 → 2024.05</code>
        <br />Conducted airflow experiments with PIV data processing and CFD simulations to analyze
        particle–airflow interactions in complex 3D geometries.
      </li>
    </ul>

    <h2>etc</h2>
    <ul>
      <li>
        <strong>Michigan Daily:</strong> News reporter, photographer, and videographer — producing
        multimedia content including short-form videos and digital features.
      </li>
      <li>
        <strong>ISTORM (UIUC):</strong> Member of the Illinois Student Organization of Meteorology,
        the student chapter of the American Meteorological Society, focused on severe and hazardous
        weather forecasting.
      </li>
      <li>
        <strong>History:</strong> Passionate about history with a minor in the subject, exploring
        how past events shape our understanding of the present.
      </li>
      <li>
        <strong>Meteorology:</strong> A lifelong fascination with weather and atmospheric science,
        from storm chasing to climate modeling.
      </li>
    </ul>
  </div>
</Base>
