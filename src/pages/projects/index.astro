---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ResearchFigure from "../../components/ResearchFigure.astro";
import MiniProject from "../../components/MiniProject.astro";
import ThemeFilter from "../../components/ThemeFilter.astro";
import { SITE } from "../../consts";

const all = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const research = all.filter((p) => p.data.kind === "research");
const others = all.filter((p) => p.data.kind !== "research");
---

<Base
  title={`Projects | ${SITE.title}`}
  description={`Research and projects by ${SITE.title} — human–AI interaction, context-aware systems, ubiquitous sensing, and AI4Science.`}
  path="/projects"
>
  <section class="block first">
    <div class="block-head">
      <h1 class="page-title">Projects</h1>
      <ThemeFilter />
    </div>
    <p class="note">* equal contribution</p>
    <div class="figs">
      {research.map((p, i) => <ResearchFigure project={p} eager={i < 2} />)}
    </div>
    <h2 class="sub-head">Other projects</h2>
    <div class="minis">
      {others.map((p) => <MiniProject project={p} />)}
    </div>
    <p class="filter-empty" hidden>No projects match the selected interests.</p>
  </section>
</Base>
