---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../consts";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title={`Projects | ${SITE.title}`}
  description={`Research projects by ${SITE.title} — generative AI for music, privacy-aware machine learning, and statistical ML.`}
  path="/projects"
>
  <div class="content">
    <h2>projects</h2>
    <div class="project-grid">
      {
        projects.map((p) => (
          <a class="project-card" href={`/projects/${p.id}/`}>
            {p.data.cover && <img class="project-cover" src={p.data.cover} alt="" loading="lazy" />}
            <div class="project-card-body">
              <h3>{p.data.title}</h3>
              <p class="project-meta">
                <code>{p.data.period}</code>
                {p.data.status === "active" && <span class="project-live">● active</span>}
              </p>
              <p class="project-tagline">{p.data.tagline}</p>
              <p class="project-tags">{p.data.tags.map((t) => <span class="tag">[{t}]</span>)}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>
