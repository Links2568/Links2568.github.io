---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../consts";
import { asset } from "../../lib/asset";
import { themeLabel } from "../../lib/themes";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

// subtitle = paper title without the repeated "Name:" prefix
const subtitle = d.fullTitle?.startsWith(`${d.title}:`)
  ? d.fullTitle.slice(d.title.length + 1).trim()
  : d.fullTitle;
const authors = (d.authors ?? "")
  .split(",")
  .map((a) => a.trim())
  .filter(Boolean)
  .map((a) => ({ name: a, me: a.replace(/\*/g, "").trim() === SITE.title }));
const equal = authors.some((a) => a.name.includes("*"));
const org = d.org?.replace(/ · /g, ", ");
const isReview = (b: string) => /review/i.test(b);

// the screening room opens on the first video; the list switches between them
const first = d.videos[0];
const metaLine = (v: (typeof d.videos)[number]) =>
  v.captions.length > 0
    ? `${v.duration}, with ${v.captions.map((c) => c.label).join(" and ")} subtitles`
    : v.duration;
---

<Base
  title={`${d.title} | ${SITE.title}`}
  description={d.tagline}
  path={`/projects/${project.id}`}
  navPath="/projects"
  noindex={d.protected}
>
  <article class="paper">
    <p class="back"><a href="/projects/">All projects</a></p>

    <header class="paper-head">
      <p class="paper-badges">
        {d.badges.map((b) => <span class:list={["badge", { "badge-review": isReview(b) }]}>{b}</span>)}
        {
          d.themes.map((t) => (
            <span class="theme-tag" data-topic={t}>
              {themeLabel(t)}
            </span>
          ))
        }
      </p>
      <h1 class="paper-title">{d.title}</h1>
      {!d.protected && subtitle && <p class="paper-subtitle">{subtitle}</p>}
      {
        !d.protected && authors.length > 0 && (
          <>
            <p class="paper-authors">
              {authors.map((a, i) => (
                <>
                  {a.me ? <strong>{a.name}</strong> : a.name}
                  {i < authors.length - 1 && ", "}
                </>
              ))}
            </p>
            <p class="paper-affil">
              University of Michigan{equal && <span class="dim"> — * equal contribution</span>}
            </p>
          </>
        )
      }
      {
        !d.protected && (d.role || org) && (
          <p class="paper-role">
            {d.role && <strong>{d.role}</strong>}{d.role && org && ", "}{org}
          </p>
        )
      }
      {
        !d.protected && (d.videos.length > 0 || d.links.length > 0 || d.bibtex) && (
          <nav class="paper-buttons" aria-label="Paper links">
            {d.videos.length > 0 && (
              <a class="btn btn-solid" href="#video">
                Video
              </a>
            )}
            {d.links.map((l) => (
              <a class="btn" href={l.url} rel="noopener">
                {l.label}
              </a>
            ))}
            {d.bibtex && (
              <a class="btn" href="#cite">
                BibTeX
              </a>
            )}
          </nav>
        )
      }
    </header>

    {
      d.protected ? (
        <>
          <div class="paper-body" id="public-desc">
            <Content />
          </div>
          <div class="locked" id="locked" data-base={`/protected/${project.id}/`}>
            <p class="locked-note">
              Reviewers and collaborators with the password can view the full write-up, demo video,
              and figures here — decrypted in your browser. To request access, email{" "}
              <span class="nowrap">{SITE.email}</span>.
            </p>
            <form class="unlock-form" id="unlock-form">
              <label class="visually-hidden" for="unlock-pw">
                Password
              </label>
              <input id="unlock-pw" type="password" autocomplete="current-password" placeholder="Password" required />
              <button class="btn btn-solid" type="submit">
                Unlock
              </button>
            </form>
            <p class="unlock-status" id="unlock-status" aria-live="polite" />
          </div>
          <div class="paper-unlocked" id="unlocked" hidden />
          <script is:inline src={asset("/scripts/unlock.js")} defer />
        </>
      ) : (
        <>
          {d.teaser && (
            <figure class="teaser">
              <a href={d.teaser.src} target="_blank" rel="noopener" class="teaser-img">
                <img src={d.teaser.src} alt={d.teaser.caption} width={d.teaser.width} height={d.teaser.height} decoding="async" />
              </a>
            </figure>
          )}
          {!d.teaser && d.hero && (
            <figure class="teaser">
              <video autoplay muted loop playsinline width={d.hero.width} height={d.hero.height} poster={d.hero.poster}>
                <source src={d.hero.src} type="video/mp4" />
              </video>
            </figure>
          )}

          <div class="paper-body">
            <Content />
          </div>

          {(d.work.length > 0 || d.skills.length > 0) && (
            <section class="paper-section" id="scope">
              <h2>What it involved</h2>
              <dl class="scope-list">
                {d.work.length > 0 && (
                  <>
                    <dt>Work</dt>
                    <dd>
                      {d.work.map((w) => (
                        <span class="chip">{w}</span>
                      ))}
                    </dd>
                  </>
                )}
                {d.skills.length > 0 && (
                  <>
                    <dt>Knowledge and tools</dt>
                    <dd>
                      {d.skills.map((s) => (
                        <span class="chip chip-soft">{s}</span>
                      ))}
                    </dd>
                  </>
                )}
              </dl>
            </section>
          )}

          {first && (
            <section class="theater" id="video" aria-labelledby="video-title">
              <h2 id="video-title">{d.videos.length > 1 ? "Videos" : "Video"}</h2>
              <div class="vp" data-player>
                <div class="vp-stage">
                  <video controls playsinline preload="none" poster={first.poster}>
                    <source src={first.src} type="video/mp4" />
                    {first.captions.map((c) => (
                      <track kind="subtitles" srclang={c.lang} label={c.label} src={c.src} />
                    ))}
                  </video>
                  <button class="vp-cover" type="button" aria-label={`Play ${first.label}`}>
                    <span class="vp-disc" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l10.6-6.8a.8.8 0 0 0 0-1.4L9.2 4.5a.8.8 0 0 0-1.2.7Z" /></svg>
                    </span>
                    <span class="vp-cover-text">
                      <span class="vp-next" hidden>Up next</span>
                      <span class="vp-cover-title">{first.label}</span>
                      <span class="vp-cover-meta">{metaLine(first)}</span>
                    </span>
                  </button>
                </div>
                {d.videos.length > 1 && (
                  <ol class="vp-list">
                    {d.videos.map((v, i) => (
                      <li>
                        <a
                          class="vp-item"
                          href={v.src}
                          aria-current={i === 0 ? "true" : undefined}
                          data-src={v.src}
                          data-poster={v.poster}
                          data-label={v.label}
                          data-meta={metaLine(v)}
                          data-captions={JSON.stringify(v.captions)}
                        >
                          <span class="vp-thumb">
                            <img src={v.poster} alt="" loading="lazy" decoding="async" />
                            <span class="vp-thumb-progress" />
                          </span>
                          <span class="vp-item-text">
                            <span class="vp-item-title">
                              <span class="vp-eq" aria-hidden="true"><i /><i /><i /></span>
                              {v.label}
                            </span>
                            <span class="vp-item-meta">{v.duration}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </section>
          )}

          {d.gallery.length > 0 && (
            <section class="paper-section paper-section-wide">
              <h2>Figures</h2>
              <div class="paper-figures">
                {d.gallery.map((g, i) => (
                  <figure class:list={[{ "is-wide": g.wide }]}>
                    <a href={g.src} target="_blank" rel="noopener">
                      <img src={g.src} alt={g.alt} width={g.width} height={g.height} loading="lazy" decoding="async" />
                    </a>
                    <figcaption>
                      <b>Figure {i + 1}.</b> {g.alt}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )}

          {d.bibtex && (
            <section class="paper-section" id="cite">
              <h2>Cite</h2>
              <div class="bibtex">
                <pre><code>{d.bibtex.trim()}</code></pre>
                <button class="btn copy-bib" type="button">
                  Copy BibTeX
                </button>
              </div>
            </section>
          )}
        </>
      )
    }
  </article>
  {!d.protected && <script is:inline src={asset("/scripts/project.js")} defer />}
</Base>
